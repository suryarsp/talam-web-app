# PUBLIC (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_ROOT_DOMAIN=talam4shop.com
NEXT_PUBLIC_OTP_SIGNIN_ENABLED=
NEXT_PUBLIC_EMAIL_OTP_ENABLED=

# SERVER ONLY — never add NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_URL_SERVICE_ROLE=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
SUPABASE_HOOK_SECRET=
RESEND_API_KEY=
CRON_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TALAM_RAZORPAY_KEY_ID=
TALAM_RAZORPAY_KEY_SECRET=
TALAM_RAZORPAY_WEBHOOK_SECRET=
# Shiprocket is per-tenant: each store connects its own account in Settings → Shipping, and
# the credentials plus that store's webhook token live encrypted in shipping_credentials.
# There are deliberately no platform-level Shiprocket env vars.
# Encrypts those credentials at rest. 32 bytes, base64: `openssl rand -base64 32`
# Rotating this invalidates every stored credential — every tenant must reconnect.
SHIPPING_CREDENTIALS_ENCRYPTION_KEY=
# Comma-separated allow-list of Talam ops emails permitted into /super-admin.
# Also the recipient list for staff notifications — if this is empty, nobody can reach
# /super-admin AND nobody is told when a shop asks for help connecting Shiprocket.
SUPER_ADMIN_EMAILS=
