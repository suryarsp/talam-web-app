generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @db.Uuid
  email     String?
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("users")
}

enum Tier {
  trial
  starter
  growth
  pro
}

enum PaymentProvider {
  upi_manual
  instamojo
  razorpay
  cod
  // phonepe — V2 only
}

enum OnboardingStage {
  business_setup
  license
  razorpay
  store_live
}

enum OnboardingStageStatus {
  not_started
  in_progress
  blocked
  done
}

enum PublishStatus {
  draft
  published
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
  returned
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum DiscountType {
  percent
  fixed
}

enum ProductUnit {
  piece
  meter
}

model Tenant {
  id                   String          @id @default(uuid()) @db.Uuid
  ownerId              String          @unique @map("owner_id") @db.Uuid
  onboardingStep       Int             @default(0) @map("onboarding_step")
  isOnboarded          Boolean         @default(false) @map("is_onboarded")
  isLive               Boolean         @default(false) @map("is_live")
  hasSeenSetupTour     Boolean         @default(false) @map("has_seen_setup_tour")
  readyToGoLiveNotifiedAt DateTime?    @map("ready_to_go_live_notified_at") @db.Timestamptz
  onboardingReminderCount Int          @default(0) @map("onboarding_reminder_count")
  slug                 String          @unique
  name                 String
  tagline              String?
  tier                 Tier            @default(trial)
  trialEndsAt          DateTime?       @map("trial_ends_at") @db.Timestamptz
  brandColor           String?         @map("brand_color")
  logoUrl              String?         @map("logo_url")
  whatsappNumber       String?         @map("whatsapp_number")
  contactPhone         String?         @map("contact_phone")
  contactEmail         String?         @map("contact_email")
  showWhatsappButton   Boolean         @default(true) @map("show_whatsapp_button")
  notifyEmailOnOrder   Boolean         @default(true) @map("notify_email_on_order")
  paymentProvider      PaymentProvider @default(upi_manual) @map("payment_provider")
  paymentConfig        Json?           @map("payment_config")
  shippingConfig       Json?           @map("shipping_config")
  notificationPreferences Json?        @map("notification_preferences")
  storeType            String?         @map("store_type")
  freeDeliveryAbove    Decimal?        @map("free_delivery_above") @db.Decimal(10, 2)
  shippingFee          Decimal         @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  deliveryEstimateText String?         @map("delivery_estimate_text")
  /// Fallback package weight in kg for any product whose own `weight` is null. Every
  /// Shiprocket rate/serviceability call needs a weight, so this must never be null —
  /// hence a default rather than an optional column.
  defaultShippingWeight Decimal        @default(0.5) @map("default_shipping_weight") @db.Decimal(6, 3)
  returnWindowDays     Int?            @map("return_window_days")
  trustBadgeText       String?         @map("trust_badge_text")
  sizeGuideUrl         String?         @map("size_guide_url")
  onboardingStage       OnboardingStage?       @default(business_setup) @map("onboarding_stage")
  onboardingStageStatus OnboardingStageStatus? @default(not_started) @map("onboarding_stage_status")
  suspendedAt          DateTime?       @map("suspended_at")
  deletedAt            DateTime?       @map("deleted_at") @db.Timestamptz
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz

  products      Product[]
  customers     Customer[]
  orders        Order[]
  orderItems    OrderItem[]
  orderStatusEvents OrderStatusEvent[]
  wishlists     Wishlist[]
  discountCodes DiscountCode[]
  categories    ProductCategory[]
  about         StoreAbout?
  branches      StoreBranch[]
  reviews       ProductReview[]
  banners       StoreBanner[]
  promotions    StorePromotion[]
  tags          ProductTag[]
  addresses     Address[]
  publishLogs   PublishLog[]
  paymentMethods PaymentMethod[]
  notifications Notification[]
  shippingCredential ShippingCredential?

  @@map("tenants")
}

/// Per-tenant Shiprocket account credentials. Separate from Tenant.shippingConfig on
/// purpose: Shiprocket has no OAuth, so this holds the shop's real account password
/// (encrypted via lib/crypto.ts). Keeping it out of the shippingConfig Json means the
/// spread-then-overwrite pattern every config writer uses can never clobber it, and no
/// existing tenant query accidentally selects ciphertext.
model ShippingCredential {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  provider       String   @default("shiprocket")
  emailCipher    String   @map("email_cipher")
  passwordCipher String   @map("password_cipher")
  /// Per-tenant webhook secret. Stored plaintext deliberately — it is displayed to the
  /// tenant so they can paste it into their own Shiprocket dashboard, so encrypting it
  /// would buy nothing. Still a secret between Talam and this one tenant: never log it.
  webhookToken   String   @map("webhook_token")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("shipping_credentials")
}

/// Platform staff who can access /super-admin. Replaces the old SUPER_ADMIN_EMAILS
/// env-var allow-list as the source of truth for access, so ops staff can be
/// added/removed from the Staff screen instead of an env var + redeploy.
model AdminStaff {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  role         AdminStaffRole @default(support_agent)
  addedAt      DateTime  @default(now()) @map("added_at") @db.Timestamptz
  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz

  @@map("admin_staff")
}

/// Owner gets every console section plus staff management. The other three are
/// section-scoped: see ROLE_SECTIONS in lib/data/admin-staff.ts for exactly what
/// each grants — kept in code, not the DB, so adjusting scope needs no migration.
enum AdminStaffRole {
  owner
  support_agent
  billing_manager
  growth_analyst
}

model Product {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  name         String
  slug         String
  description  String?
  price        Decimal       @db.Decimal(10, 2)
  comparePrice Decimal?      @map("compare_price") @db.Decimal(10, 2)
  categoryId   String?       @map("category_id") @db.Uuid
  sizes        String[]
  unit         ProductUnit   @default(piece)
  images       String[]
  stockBySize  Json          @default("{}") @map("stock_by_size")
  specifications Json        @default("[]")
  /// Shipping weight in kg. Nullable because most existing products predate it — callers
  /// fall back to Tenant.defaultShippingWeight rather than guessing per product.
  weight       Decimal?      @db.Decimal(6, 3)
  isActive     Boolean       @default(true) @map("is_active")
  status       PublishStatus @default(published)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant               Tenant                  @relation(fields: [tenantId], references: [id])
  category             ProductCategory?        @relation(fields: [categoryId], references: [id])
  orderItems           OrderItem[]
  wishlists            Wishlist[]
  reviews              ProductReview[]
  banners              StoreBanner[]
  tagAssignments       ProductTagAssignment[]
  promotionAssignments StorePromotionProduct[]

  @@unique([tenantId, slug])
  @@map("products")
}

model ProductCategory {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  slug       String
  department String?  @db.VarChar(20)
  isDefault  Boolean  @default(false) @map("is_default")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, slug])
  @@map("product_categories")
}

model Customer {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  name                String?
  phone               String?
  email               String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  preferredCategories String[]  @default([]) @map("preferred_categories")
  preferredSize       String?   @map("preferred_size")
  onboardingComplete  Boolean   @default(false) @map("onboarding_complete")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  notifyDeals         Boolean   @default(true) @map("notify_deals")
  notifyOrderUpdates  Boolean   @default(true) @map("notify_order_updates")
  notifyPromotions    Boolean   @default(false) @map("notify_promotions")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  orders         Order[]
  wishlists      Wishlist[]
  reviews        ProductReview[]
  addresses      Address[]
  paymentMethods PaymentMethod[]

  @@map("customers")
}

model PaymentMethod {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  upiId      String   @map("upi_id")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@map("payment_methods")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  label      String
  name       String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  phone      String
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@map("addresses")
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  customerId      String        @map("customer_id") @db.Uuid
  status          OrderStatus   @default(pending)
  // Stored, not derived: an order has to be able to reproduce its own invoice years
  // later, even after product prices, shipping fees or coupons have changed.
  itemsTotal      Decimal       @default(0) @map("items_total") @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  shippingFee     Decimal       @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  discountCode    String?       @map("discount_code")
  total           Decimal       @db.Decimal(10, 2)
  paymentProvider String?       @map("payment_provider")
  paymentId       String?       @map("payment_id")
  paymentStatus   PaymentStatus @default(pending) @map("payment_status")
  shippingAddress Json          @map("shipping_address")
  trackingId      String?       @map("tracking_id")
  // Shiprocket's own ids for this order, kept alongside the AWB (trackingId) so support can
  // find the shipment in Shiprocket's dashboard without re-deriving it from our order id.
  shiprocketOrderId String?     @map("shiprocket_order_id")
  shipmentId      String?       @map("shipment_id")
  courierName     String?       @map("courier_name")
  /// Courier ETA in days as quoted by Shiprocket at checkout, stored so the order's own
  /// confirmation and emails can repeat the promise made at the time — not re-derived later,
  /// for the same reason the price breakdown above is stored rather than computed.
  estimatedDeliveryDays Int?    @map("estimated_delivery_days")
  disputeFlaggedAt DateTime?    @map("dispute_flagged_at")
  disputeReason   String?       @map("dispute_reason")
  cancelReason    String?       @map("cancel_reason")
  paymentProofUrl String?       @map("payment_proof_url")
  // Manual-refund audit trail (COD/UPI cancellations): the UPI-transfer screenshot staff
  // uploaded, and who signed off on it. `refundProofUrl IS NOT NULL AND refundVerifiedAt IS
  // NULL` *is* the "awaiting verification" state — deliberately not a new OrderStatus value,
  // which would ripple through every status filter in the app.
  refundProofUrl  String?       @map("refund_proof_url")
  refundVerifiedBy String?      @map("refund_verified_by")
  refundVerifiedAt DateTime?    @map("refund_verified_at") @db.Timestamptz
  reminderSentAt  DateTime?     @map("reminder_sent_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  customer     Customer            @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  statusEvents OrderStatusEvent[]

  @@map("orders")
}

/** Written once per status transition (see lib/data/orders.ts:updateOrderStatus) so both the
 *  admin and customer-facing order timelines can show a real date/time per completed step. */
model OrderStatusEvent {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  changedAt DateTime    @default(now()) @map("changed_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([orderId, changedAt])
  @@map("order_status_events")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  productName String  @map("product_name")
  size        String?
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Wishlist {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  priceAtSave Decimal? @map("price_at_save") @db.Decimal(10, 2)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([tenantId, customerId, productId])
  @@map("wishlists")
}

model DiscountCode {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  code      String
  type      DiscountType
  value     Decimal      @db.Decimal(10, 2)
  minOrder  Decimal?     @map("min_order") @db.Decimal(10, 2)
  usesLimit Int?         @map("uses_limit")
  usesCount Int          @default(0) @map("uses_count")
  expiresAt DateTime?    @map("expires_at") @db.Timestamptz
  isActive  Boolean      @default(true) @map("is_active")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("discount_codes")
}

model StoreAbout {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @unique @map("tenant_id") @db.Uuid
  storyTitle        String?       @map("story_title")
  description       String?
  ownerPhotoUrl     String?       @map("owner_photo_url")
  ownerName         String?       @map("owner_name")
  ownerTitle        String?       @map("owner_title")
  instagramUrl      String?       @map("instagram_url")
  facebookUrl       String?       @map("facebook_url")
  youtubeUrl        String?       @map("youtube_url")
  googleBusinessUrl String?       @map("google_business_url")
  socialLinks       Json          @default("[]") @map("social_links")
  galleryUrls       String[]      @default([]) @map("gallery_urls")
  status            PublishStatus @default(published)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("store_about")
}

model StoreBranch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  address   String?
  city      String?
  state     String?
  phone     String?
  hours     String?
  mapsUrl   String?  @map("maps_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("store_branches")
}

model ProductReview {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  customerId         String   @map("customer_id") @db.Uuid
  rating             Int
  comment            String?
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  isDeleted          Boolean  @default(false) @map("is_deleted")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  product  Product        @relation(fields: [productId], references: [id])
  customer Customer       @relation(fields: [customerId], references: [id])
  reports  ReviewReport[]

  @@unique([tenantId, productId, customerId])
  @@map("product_reviews")
}

model ReviewReport {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  reviewId   String   @map("review_id") @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  reason     String // 'spam' | 'inappropriate' | 'fake' | 'other'
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  review ProductReview @relation(fields: [reviewId], references: [id])

  @@unique([tenantId, reviewId, reporterId])
  @@map("review_reports")
}

model StoreBanner {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  headline  String?
  subtitle  String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@map("store_banners")
}

model StorePromotion {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  offerText String    @map("offer_text")
  subtitle  String?
  linkUrl   String?   @map("link_url")
  endsAt    DateTime? @map("ends_at") @db.Timestamptz
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant                  @relation(fields: [tenantId], references: [id])
  products StorePromotionProduct[]

  @@map("store_promotions")
}

model StorePromotionProduct {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  promotionId String @map("promotion_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid

  promotion StorePromotion @relation(fields: [promotionId], references: [id])
  product   Product        @relation(fields: [productId], references: [id])

  @@unique([tenantId, promotionId, productId])
  @@map("store_promotion_products")
}

enum OccasionLayout {
  grid
  carousel
}

model ProductTag {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  name      String
  slug      String
  emoji     String?
  isDefault Boolean        @default(false) @map("is_default") // platform-seeded occasion (e.g. Diwali, Pongal) — not owner-deletable
  themeKey  String?        @map("theme_key") // key into the code-level OCCASION_THEMES registry; null = generic fallback banner
  layout    OccasionLayout @default(grid) // how the storefront occasion page displays its products
  sortOrder Int            @default(0) @map("sort_order")
  status    PublishStatus  @default(published)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  products ProductTagAssignment[]

  @@unique([tenantId, slug])
  @@map("product_tags")
}

model ProductTagAssignment {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order") // manual product order within the occasion — drives carousel + grid order

  product Product    @relation(fields: [productId], references: [id])
  tag     ProductTag @relation(fields: [tagId], references: [id])

  @@unique([tenantId, productId, tagId])
  @@map("product_tag_assignments")
}

model PublishLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz
  itemCount   Int      @map("item_count")
  summary     String
  items       Json     @default("[]") @map("items")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("publish_logs")
}

// ponytail: `type` is a plain string, not an enum — only "go_live_ready" exists today, and new
// notification types (order events, payment alerts) will just be new string values, no migration.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("notifications")
}
